[[42, 43, "\ud83d\udcca \u0627\u06a9\u0633\u0644 \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u0647\u0627\u06cc \u0631\u0648\u0632\u0645\u0631\u0647\u061b \u0627\u0632 \u0635\u0641\u0631 \u062a\u0627 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc&#33; \u0646\u0647 \u062f\u0648\u0631\u0647 \u0637\u0648"], [43, 55, "\ud83d\udee0 \u06f1\u06f2 \u0627\u0628\u0632\u0627\u0631 \u0622\u0646\u0644\u0627\u06cc\u0646 \u0631\u0627\u06cc\u06af\u0627\u0646 \u06a9\u0647 \u0628\u0647\u0631\u0647\u200c\u0648\u0631\u06cc\u062a \u0631\u0648 \u0645\u062a\u062d\u0648\u0644 \u0645\u06cc\u200c\u06a9\u0646\u0647&#33; \u0628"], [44, 60, "\ud83d\udcbb \u0646\u0642\u0634\u0647 \u0631\u0627\u0647 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0646\u0648\u06cc\u0633\u06cc \u0627\u0632 \u0635\u0641\u0631\u061b \u0627\u0632 \u06a9\u062c\u0627 \u0634\u0631\u0648\u0639 \u06a9\u0646\u0645\u061f \u0645\u0633\u06cc\u0631 \u0642\u062f\u0645\u200c\u0628\u0647"], [47, 65, "\ud83c\udf10 \u0633\u0627\u06cc\u062a \u062e\u0648\u062f\u062a \u0631\u0648 \u0628\u0633\u0627\u0632\u061b \u0628\u062f\u0648\u0646 \u06a9\u062f\u0646\u0648\u06cc\u0633\u06cc&#33; \u0631\u0627\u0647\u0646\u0645\u0627\u06cc \u06af\u0627\u0645\u200c\u0628\u0647\u200c\u06af\u0627\u0645 \u0633\u0627"], [48, 86, "\ud83d\udd17 \u062c\u0632\u0648\u0647 \u062f\u0631\u0633 \u0646\u0635\u0628 \u0648 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0645\u0642\u0637\u0639 \u06f1\u06f2"], [50, 66, "\ud83d\udd17 \u062c\u0632\u0648\u0647 \u062f\u0631\u0633 \u0646\u0635\u0628 \u0648 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u06a9\u0644\u0627\u0633 \u06f1\u06f2 - \u062a\u062c\u0647\u06cc\u0632\u0627\u062a passive \u2139\ufe0f \u0627\u0632 \u06a9\u0644\u0627"], [51, 52, "\u062c\u0632\u0648\u0647 \u062f\u0631\u0633 \u0627\u0645\u0646\u06cc\u062a \u0633\u0627\u06cc\u0628\u0631\u06cc \u06a9\u0644\u0627\u0633 \u06f1\u06f2B"], [52, 45, "\u062c\u0632\u0648\u0647 \u062f\u0631\u0633 \u0646\u0635\u0628 \u0648 \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u062a\u062c\u0647\u06cc\u0632\u0627\u062a \u0641\u0639\u0627\u0644 \u0628\u0631\u0627\u06cc \u0647\u0631 \u062f\u0648 \u06a9\u0644\u0627\u0633 \u062a\u06a9\u0644\u06cc\u0641 \u062d\u062a"], [53, 37, "\u0628\u0631\u0627\u06cc \u06a9\u0644\u0627\u0633 \u06f1\u06f0 \u062a\u06a9\u0644\u06cc\u0641 \u0622\u062e\u0631 \u0627\u0646\u062c\u0627\u0645 \u0628\u062f\u06cc\u0646 \u0633\u0647 \u0634\u0646\u0628\u0647 \u0627\u0645\u062a\u062d\u0627\u0646 \u062f\u0627\u0631\u06cc\u0646"], [54, 33, "\u06a9\u0644\u0627\u0633 \u06f1\u06f0"], [55, 22, "\ud83c\udfac \u062a\u0627 \u062d\u0627\u0644\u0627 \u0622\u0631\u0632\u0648 \u06a9\u0631\u062f\u06cc \u06cc\u0647 \u06a9\u0627\u0631\u0645\u0646\u062f \u06a9\u0648\u0686\u06cc\u06a9 \u062f\u0627\u0634\u062a\u06cc \u06a9\u0647 \u062e\u0648\u062f\u0634 \u06a9\u0627\u0631 \u0645\u06cc\u200c\u06a9\u0631\u062f"], [56, 20, "\ud83d\udcbb \u06cc\u0647 \u062c\u0645\u0644\u0647 \u0628\u06af\u0648: \u00ab\u06cc\u0647 \u0627\u067e \u0631\u0632\u0631\u0648 \u0646\u0648\u0628\u062a \u0628\u0633\u0627\u0632\u00bb \u2014 \u0648 \u06f5 \u062f\u0642\u06cc\u0642\u0647 \u0628\u0639\u062f \u0627\u067e\u062a \u062f\u0627"], [57, 19, "\ud83c\udfb5 \u0628\u0627 \u062a\u0627\u06cc\u067e \u06cc\u0647 \u062c\u0645\u0644\u0647\u060c \u0622\u0647\u0646\u06af \u06a9\u0627\u0645\u0644 \u0628\u0627 \u0648\u06a9\u0627\u0644 \u0648 \u0645\u06cc\u06a9\u0633 \u0627\u0633\u062a\u0648\u062f\u06cc\u0648\u06cc\u06cc \u062a\u062d\u0648\u06cc\u0644 "], [58, 30, "\ud83d\udea8 \u06cc\u0647 \u0634\u0631\u06a9\u062a \u06f2\u06f5 \u0645\u06cc\u0644\u06cc\u0648\u0646 \u062f\u0644\u0627\u0631 \u0628\u0627\u062e\u062a\u061b \u0686\u0648\u0646 \u062a\u0648 \u062c\u0644\u0633\u0647 \u0648\u06cc\u062f\u06cc\u0648\u06cc\u06cc \u00ab\u0645\u062f\u06cc\u0631 \u0645\u0627\u0644"], [59, 16, "\ud83d\udc0d \u067e\u0627\u06cc\u062a\u0648\u0646: \u0632\u0628\u0627\u0646\u06cc \u06a9\u0647 ChatGPT\u060c \u0627\u06cc\u0646\u0633\u062a\u0627\u06af\u0631\u0627\u0645 \u0648 \u0646\u062a\u0641\u0644\u06cc\u06a9\u0633 \u0628\u0627\u0647\u0627\u0634 \u0633\u0627\u062e\u062a\u0647"], [60, 15, "\u2699\ufe0f \u0627\u0648\u0646 \u06af\u0632\u0627\u0631\u0634 \u0627\u06a9\u0633\u0644\u06cc \u06a9\u0647 \u0647\u0631 \u0647\u0641\u062a\u0647 \u06f5 \u0633\u0627\u0639\u062a \u0648\u0642\u062a\u0647\u061f \u067e\u0627\u06cc\u062a\u0648\u0646 \u06cc\u06a9\u200c\u06a9\u0644\u06cc\u06a9\u0647\u200c\u0634"], [61, 15, "\ud83e\udde0 \u0645\u06cc\u200c\u062e\u0648\u0627\u06cc \u0627\u0632 \u00ab\u06a9\u0627\u0631\u0628\u0631 ChatGPT\u00bb \u0628\u0647 \u00ab\u0633\u0627\u0632\u0646\u062f\u0647 AI\u00bb \u062a\u0628\u062f\u06cc\u0644 \u0628\u0634\u06cc\u061f \u06a9\u0644 \u0627\u06a9"], [62, 5, "\ud83d\udcb0 \u0631\u0627\u0647\u0646\u0645\u0627\u06cc \u062e\u0631\u06cc\u062f \u0627\u0648\u0644\u06cc\u0646 \u0627\u0631\u0632 \u062f\u06cc\u062c\u06cc\u062a\u0627\u0644\u062a\u060c \u0628\u06cc\u200c\u0627\u0633\u062a\u0631\u0633&#33; \u0627\u0646\u062a\u062e\u0627\u0628 \u0635\u0631\u0627\u0641"], [63, 5, "\ud83e\udd1d \u0627\u0641\u06cc\u0644\u06cc\u062a \u0645\u0627\u0631\u06a9\u062a\u06cc\u0646\u06af: \u062f\u0631\u0622\u0645\u062f\u06cc \u06a9\u0647 \u0628\u0647 \u0641\u0627\u0644\u0648\u0648\u0631 \u0645\u06cc\u0644\u06cc\u0648\u0646\u06cc \u0646\u06cc\u0627\u0632 \u0646\u062f\u0627\u0631\u0647&#3"], [64, 6, "\ud83d\ude80 \u0622\u0698\u0627\u0646\u0633 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06cc \u062a\u06a9\u200c\u0646\u0641\u0631\u0647: \u0686\u0646\u062f \u0635\u062f \u062a\u0648\u0645\u0646 \u062e\u0631\u062c \u06a9\u0646\u060c \u0645\u06cc\u0644\u06cc\u0648\u0646\u200c\u0647\u0627 \u0628\u0641"]]